# Hikâye Atölyesi Yapılandırması (İsteğe Bağlı)
# Not: Uygulama API anahtarı olmadan da yüksek kaliteli yerel edebi motoruyla %100 çalışır!

# Google Gemini API Anahtarınız (Sunucu üzerinden güvenli proxy kullanımı için):
GEMINI_API_KEY=

# Varsayılan Gemini Modeli:
GEMINI_MODEL=gemini-1.5-flash

# Sunucu Portu (Varsayılan 3000):
PORT=3000
